# dorfq as a systemd system service. Install as
# /etc/systemd/system/dorfq.service, with
#   /usr/local/bin/dorfq                the binary from `make optimised`
#   /etc/dorfq/dorfq.toml               the configuration (see ../../github.toml)
#   /etc/dorfq/token.env                DORFQ_GITHUB_TOKEN=<token>, and with
#                                       [forge.webhook] DORFQ_WEBHOOK_SECRET=<secret>,
#                                       mode 0600
# then `systemctl enable --now dorfq`. Every piece of queue state lives in
# the repository, so the service runs as a throwaway user with no files of
# its own; systemd reads the environment file as root before dropping to it.
#
# As a GitHub App instead of a token: keep the app's key root-only as
#   /etc/dorfq/app-key.pem              the app's private key, mode 0600
# uncomment the LoadCredential= line, drop the EnvironmentFile= line unless
# the file holds the webhook secret, and set in the configuration
#   [forge.auth]
#   kind = "app"
#   client_id = "<the app's Client ID>"
#   private_key_file = "/run/credentials/dorfq.service/app-key"
# systemd copies the key there for the unit's dynamic user at start.
#
# dorfq exits only on a Permanent error, which a restart does not cure; the
# delay keeps a restart loop slow while the cause is found.

[Unit]
Description=dorfq merge queue
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/dorfq run --config /etc/dorfq/dorfq.toml
EnvironmentFile=/etc/dorfq/token.env
#LoadCredential=app-key:/etc/dorfq/app-key.pem
DynamicUser=yes
Restart=on-failure
RestartSec=5min

[Install]
WantedBy=multi-user.target
