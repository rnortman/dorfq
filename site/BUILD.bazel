load(":wasm.bzl", "wasm_module")

# The simulation page's data: each shipped simulator example run through
# `dorfq-sim run --json`, plus the index the page reads to list them. The
# static files (site/*.html, *.js, *.css) have no build.
# TODO(test-site-app-js-untested-against-report-schema): nothing checks that
# app.js parses or that the fields it reads exist in these documents.
#
# These rules are part of `//...`, so the gate runs every example: a
# replication that fails makes `dorfq-sim` exit 1 and the build red.

EXAMPLES = [
    "busy",
    "outage",
    "sim",
]

[genrule(
    name = "report_" + example,
    srcs = ["//crates/dorfq-sim:examples/%s.toml" % example],
    outs = ["reports/%s.json" % example],
    cmd = "$(execpath //crates/dorfq-sim) run --config $< --json $@",
    tools = ["//crates/dorfq-sim"],
) for example in EXAMPLES]

genrule(
    name = "report_index",
    outs = ["reports/index.json"],
    cmd = "echo '%s' > $@" % json.encode(EXAMPLES),
)

filegroup(
    name = "reports",
    srcs = [":report_index"] + [":report_" + example for example in EXAMPLES],
)

# The playground's simulator: dorfq-sim compiled to WebAssembly. Part of
# `//...`, so the gate builds it and a dependency that stops compiling for
# wasm32 is a red build, not a red deploy.
wasm_module(
    name = "wasm",
    out = "dorfq_sim_wasm.wasm",
    deps = ["//crates/dorfq-sim-wasm:dorfq_sim_wasm"],
)
