# The libc a target platform links against. Every platform that does not say
# otherwise, the host included, has `glibc`: the hermetic LLVM toolchain links
# against a glibc sysroot and is the only cc toolchain for such platforms.
# `musl` selects the musl cc toolchain and the musl Rust toolchain, and is set
# only by :linux-x86_64-musl.
constraint_setting(
    name = "libc",
    default_constraint_value = ":glibc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "glibc",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
    visibility = ["//visibility:public"],
)

# The portable binary's target: x86_64 Linux, statically linked against musl.
platform(
    name = "linux-x86_64-musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":musl",
    ],
    visibility = ["//visibility:public"],
)
